# GUDHI headers
git_repository(
    name = "gudhi",
    remote = "https://github.com/GUDHI/gudhi-devel.git",
    commit = "0e59e57",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gudhi",
    hdrs = glob([
        "src/Alpha_complex/include/gudhi/**",
        "src/Simplex_tree/include/gudhi/**",
        "src/common/include/gudhi/**",
    ]),
    includes = [
        "src/Alpha_complex/include",
        "src/Simplex_tree/include",
        "src/common/include",
    ],
    deps = [
        "@boost//:boost_headers",
        "@cgal//:cgal",
        "@eigen//:eigen",
    ],
)
""",
)
